QWidget {
    background-color: #faf5f6; /* Чуть более заметный розоватый фон */
    font-family: "Georgia", "Times New Roman", serif;
    font-size: 14px;
    color: #332a2c; /* Темнее для контраста */
}

QLabel#titleLabel {
    font-size: 28px;
    font-weight: 300;
    letter-spacing: 4px;
    color: #c97b8e; /* Более яркий пыльно-розовый */
    padding: 15px 10px;
    text-transform: uppercase;
}

QTabWidget::pane {
    border: 1px solid #ebd5d9;
    background-color: #ffffff;
    border-radius: 2px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f2e6e8; /* Легкий фон для неактивных вкладок */
    color: #8c7379;
    padding: 10px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-bottom: none;
    font-size: 13px; /* Чуть крупнее, но помещается */
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #ebd5d9;
    color: #5c454a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #c97b8e; /* Яркий акцент для активной вкладки */
    border-top: 2px solid #c97b8e;
    font-weight: bold;
}

QPushButton {
    background-color: #d98a9c; /* Более насыщенный розовый */
    color: #ffffff;
    border: 1px solid #d98a9c;
    border-radius: 0px;
    padding: 9px 20px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: "Segoe UI", Arial, sans-serif;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #c46f84;
    border-color: #c46f84;
}

QPushButton:pressed {
    background-color: #a85a6e;
}

QPushButton:disabled {
    background-color: #f2e6e8;
    border-color: #f2e6e8;
    color: #bdaeb1;
}

QPushButton#btnDeleteClothes,
QPushButton#btnDeleteOutfit,
QPushButton#btnCancel {
    background-color: #ffffff;
    color: #b85065;
    border: 1px solid #e8bcc4;
}

QPushButton#btnDeleteClothes:hover,
QPushButton#btnDeleteOutfit:hover,
QPushButton#btnCancel:hover {
    background-color: #fcf0f2;
    border-color: #d98a9c;
}

QLineEdit, QComboBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #ebd5d9;
    border-radius: 0px;
    padding: 8px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #f2e6e8;
    selection-color: #332a2c;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #d98a9c; /* Яркая рамка при фокусе */
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #d98a9c;
    margin-right: 8px;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #ebd5d9;
    border-radius: 2px;
    gridline-color: #f5eaec;
    selection-background-color: #f2e6e8;
    selection-color: #332a2c;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #fcf8f9;
    color: #a88b91;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #ebd5d9; /* Более заметная линия */
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #ebd5d9;
    border-radius: 2px;
    padding: 4px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f5eaec;
}

QListWidget::item:selected {
    background-color: #fcf0f2;
    color: #c97b8e;
    border-bottom: 1px solid #d98a9c;
    font-weight: bold;
}

QListWidget::item:hover {
    background-color: #faf5f6;
}

QProgressBar {
    border: 1px solid #ebd5d9;
    border-radius: 0px;
    text-align: center;
    background-color: #faf5f6;
    color: #332a2c;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #d98a9c;
}

QGroupBox {
    border: 1px solid #ebd5d9;
    border-radius: 2px;
    margin-top: 12px;
    padding-top: 12px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #c97b8e;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    background-color: #faf5f6;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #e8dade;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #d98a9c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #e8dade;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #d98a9c;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QDialog {
    background-color: #faf5f6;
}

QToolTip {
    background-color: #c97b8e;
    color: #ffffff;
    border: none;
    padding: 6px 10px;
    font-size: 12px;
}